# Handora Environment Configuration Template
# Copy to .env and fill in. .env is gitignored, but note it IS bundled into the
# app package — treat anything here as readable by anyone holding the APK.

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini access — set ONE of the following.
#
# Preferred: the Supabase Edge Function in supabase/functions/gemini/, which
# holds the API key server-side so it never ships in the app.
#   supabase secrets set GEMINI_API_KEY=<your key>
#   supabase functions deploy gemini
# GEMINI_PROXY_URL=https://<project-ref>.supabase.co/functions/v1/gemini

# Fallback for local demos: calls Google directly with the key below. This key
# is billable and extractable from the APK — do not ship a build using it.
GEMINI_API_KEY=your_google_gemini_api_key
